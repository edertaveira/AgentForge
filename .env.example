# Optional OpenAI analysis provider. The local demo does not require a key.
ANALYSIS_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional override: local or jira. Leave unset to select Jira when credentials exist.
# TASK_SOURCE=local
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SPACE_KEY=AF
JIRA_ISSUE_KEY=AF-1

# Fine-grained token: Contents (write) and Pull requests (write).
GITHUB_TOKEN=
GITHUB_OWNER=your-user
GITHUB_REPO=AgentForge
GITHUB_BASE_BRANCH=main
GITHUB_TARGET_PREFIX=examples/taskboard-template
