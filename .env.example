# Optional OpenAI analysis provider. The local demo does not require a key.
ANALYSIS_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional override: local or jira. Leave unset to select Jira when credentials exist.
# TASK_SOURCE=local
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SPACE_KEY=AF
JIRA_ISSUE_KEY=AF-1
JIRA_BLOCKED_LABEL=agentforge-needs-input
JIRA_STATUS_IN_PROGRESS=Em andamento
JIRA_STATUS_BLOCKED=Bloqueado
JIRA_STATUS_IN_REVIEW=Em revisão
JIRA_STATUS_DONE=Concluído

# `agentforge run` uses these values to create a branch, commit, and Pull Request automatically.
# Fine-grained token: Contents (write) and Pull requests (write). No merge permission is used.
GITHUB_TOKEN=
# Optional for GitHub.com repositories: the CLI infers these values from origin.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_MERGE_POLL_SECONDS=5
GITHUB_MERGE_WAIT_SECONDS=1800
